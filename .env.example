# Local Ghost 6 + MySQL environment for docker-compose.dev.yml.
# Copy this file to .env and replace every placeholder before starting the stack.
#
#   cp .env.example .env
#   yarn ghost:up
#
# The theme is mounted from THEME_PATH, and Ghost's content (including the database,
# uploads and logs) lives under GHOST_DATA_PATH.

# Required — MySQL credentials.
# These must not change once the database volume has been initialised.
DATABASE_ROOT_PASSWORD=changeme
DATABASE_USER=ghost
DATABASE_PASSWORD=changeme

# Required — absolute host paths.
THEME_PATH=/absolute/path/to/sredevopsorg-ghost-theme
GHOST_DATA_PATH=/absolute/path/to/ghost-data

# The compose file fixes the publication URL to http://localhost:2368 and the
# database name to "ghost"; there is no need to set DOMAIN, GHOST_PORT or
# DATABASE_NAME here.

# Optional — Ghost transactional email (staff sign-in verification, import notices).
# Leave commented out unless you need mail. The local stack does not run Mailpit.
# mail__transport=Direct
# mail__options__host=smtp.example.com
# mail__options__port=465
# mail__options__secure=true
# mail__options__auth__user=changeme
# mail__options__auth__pass=changeme
