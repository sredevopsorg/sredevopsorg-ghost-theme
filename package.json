{
    "name": "sredevopsorg-ghost-theme",
    "description": "Ghost 6 theme for SREDevOps.org (https://www.sredevops.org) multi-locale, Tailwind CSS v4 via Vite, React islands, light and dark palettes, and tag-based language filtering.",
    "demo": "https://www.sredevops.org",
    "homepage": "https://www.sredevops.org",
    "docs": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme#readme",
    "version": "3.2.2",
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "ghost": ">=6.0.0",
        "node": ">=24"
    },
    "license": "MIT",
    "resolutions": {
        "handlebars": "4.7.10"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "yarn verify",
        "test:gscan": "gscan .",
        "test:gscan:verbose": "gscan --verbose .",
        "test:ci": "yarn test:gscan",
        "test:dev": "yarn test:gscan:verbose",
        "test:ship": "node scripts/ship-manifest.mjs --check",
        "test:unit": "node --test \"tests/*.test.mjs\"",
        "test:bundle": "node scripts/smoke-bundle.mjs",
        "test:classes": "node scripts/class-coverage.mjs --css assets/built --css assets/vendor",
        "test:sec-feed-layout": "node scripts/verify-sec-feed-layout.mjs",
        "verify": "yarn build && yarn test:ci && yarn test:ship && yarn test:unit && yarn test:bundle && yarn test:classes",
        "ghost:up": "docker compose -f docker-compose.dev.yml up -d",
        "ghost:down": "docker compose -f docker-compose.dev.yml down",
        "ghost:restart": "docker compose -f docker-compose.dev.yml restart ghost",
        "ghost:logs": "docker compose -f docker-compose.dev.yml logs -f ghost",
        "fixtures:capture": "node scripts/fixtures.mjs capture",
        "fixtures:normalize": "node scripts/fixtures.mjs normalize",
        "fixtures:diff": "node scripts/fixtures.mjs diff",
        "fixtures:promote": "node scripts/fixtures.mjs promote",
        "sync:fonts": "node scripts/sync-fonts.mjs",
        "sync:icons": "node scripts/sync-icons.mjs",
        "package": "node scripts/package-theme.mjs"
    },
    "author": {
        "name": "Nicolas Georger",
        "email": "info@sredevops.org",
        "url": "https://sredevops.org"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Dark",
            "Light",
            "Magazine",
            "Sidebar navigation"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "tailwindcss",
        "vite",
        "react",
        "multilingual",
        "i18n",
        "dark-mode"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme"
    },
    "bugs": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme/issues",
    "contributors": [
        {
            "name": "SREDevOps.org contributors",
            "url": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme/graphs/contributors"
        }
    ],
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^5.2.0",
        "gscan": "6.6.1",
        "prismjs": "^1.30.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.5SS"
    },
    "config": {
        "posts_per_page": 12,
        "card_assets": true,
        "custom": {
            "show_search": {
                "type": "boolean",
                "default": true,
                "description": "Show a search icon in the main navigation"
            },
            "show_login": {
                "type": "boolean",
                "default": true,
                "description": "Show a sign-in link in the main navigation"
            },
            "sec_feed_api_url": {
                "type": "text",
                "default": "",
                "group": "homepage",
                "description": "Origin of the security feed API, e.g. https://security-feed.sredevops.org. Empty hides it."
            },
            "sec_feed_items": {
                "type": "select",
                "default": "3",
                "group": "homepage",
                "options": [
                    "3",
                    "5",
                    "10",
                    "15",
                    "20"
                ],
                "description": "How many advisories the security feed widget shows"
            },
            "featured_tag": {
                "type": "text",
                "default": "",
                "group": "homepage",
                "description": "Extra tag slug ANDed into the featured hero filter, e.g. news. Empty adds no tag of its own."
            },
            "featured_only": {
                "type": "boolean",
                "default": true,
                "group": "homepage",
                "description": "Require the Featured flag on the hero post. Off shows the newest post matching the tag filter."
            }
        },
        "image_sizes": {
            "xs": {
                "width": 100
            },
            "s": {
                "width": 220
            },
            "m": {
                "width": 300
            },
            "l": {
                "width": 600
            },
            "xl": {
                "width": 900
            }
        }
    }
}
