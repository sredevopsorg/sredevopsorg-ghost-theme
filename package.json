{
    "name": "sredevopsorg-ghost-theme",
    "description": "Ghost v6 Theme for SREDevOps.org (https://www.sredevops.org) — Multi-locale, Tailwind CSS v4 via Vite, responsive, dark-mode first and tag-based language filtering.",
    "demo": "https://www.sredevops.org",
    "version": "2.1.5",
    "type": "module",
    "engines": {
        "ghost": ">=6.0.0",
        "node": ">=24"
    },
    "license": "MIT",
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test:dev": "gscan --verbose .",
        "test:ci": "gscan --verbose .",
        "test:ship": "node scripts/ship-manifest.mjs --check",
        "verify": "yarn build && gscan . && node scripts/ship-manifest.mjs --check && yarn test:unit && yarn test:bundle && yarn test:classes",
        "ghost:up": "docker compose -f docker-compose.dev.yml up -d",
        "ghost:down": "docker compose -f docker-compose.dev.yml down",
        "ghost:restart": "docker compose -f docker-compose.dev.yml restart ghost",
        "fixtures:capture": "node scripts/fixtures.mjs capture",
        "fixtures:normalize": "node scripts/fixtures.mjs normalize",
        "fixtures:diff": "node scripts/fixtures.mjs diff",
        "fixtures:promote": "node scripts/fixtures.mjs promote",
        "test:bundle": "node scripts/smoke-bundle.mjs",
        "test:classes": "node scripts/class-coverage.mjs --css assets/built --css assets/vendor",
        "test:unit": "node --test \"tests/*.test.mjs\""
    },
    "author": {
        "name": "Nicolas Georger",
        "email": "info@sredevops.org",
        "url": "https://sredevops.org"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Dark",
            "Magazine",
            "Sidebar navigation"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme"
    },
    "bugs": "https://github.com/sredevopsorg/sredevopsorg-ghost-theme/issues",
    "contributors": [
        "https://github.com/sredevopsorg/sredevopsorg-ghost-theme/graphs/contributors"
    ],
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^5.2.0",
        "gscan": "6.6.1",
        "prismjs": "^1.30.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.6"
    },
    "config": {
        "posts_per_page": 12,
        "card_assets": true,
        "custom": {
            "show_search": {
                "type": "boolean",
                "default": true,
                "description": "Show a search icon in the main navigation"
            },
            "show_login": {
                "type": "boolean",
                "default": true,
                "description": "Show a sign-in link in the main navigation"
            }
        },
        "image_sizes": {
            "xs": {
                "width": 100
            },
            "s": {
                "width": 220
            },
            "m": {
                "width": 300
            },
            "l": {
                "width": 600
            },
            "xl": {
                "width": 900
            }
        }
    }
}
