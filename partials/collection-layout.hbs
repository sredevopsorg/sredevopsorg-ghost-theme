{{!-- Shared listing layout for the root channel and the locale collections.
{{!--
     `locale` selects the hero's wording and the cards' date format and reading time.
     `header` is "site" for the root channel (title + description) or "tag" for a
     collection that carries tag data (routes.yaml `data: tag.<slug>`), which is what
     /es/ and /br/ use.
     `mixedFeed` is set by home.hbs only and is informational: the hero and the grid read
     the page's own `posts` list, which Ghost already produced with the channel's filter
     (none on `/`), so neither of them re-filters by language. `locale` still selects the
     cards' date/reading-time strings. --}}
<div class="max-w-6xl mx-auto pb-12">
    {{#match header "=" "site"}}
    {{!-- Page Title & Description --}}
    <div class="mb-10 border-b border-border-subtle pb-6">
        <h1 class="text-4xl md:text-5xl font-bold text-strong tracking-tight">{{@site.title}}</h1>
        <p class="text-muted mt-2 text-lg">{{@site.description}}</p>
    </div>
    {{else}}
    {{#is "tag" }}
    {{#tag}}
    {{!-- Tag Name & Description --}}
    <div class="mb-10 border-b border-border-subtle pb-6">
        <h1 class="text-4xl md:text-5xl font-bold text-strong tracking-tight">{{name}}</h1>
        {{#if description}}
        <p class="text-muted mt-2 text-lg">{{description}}</p>
        {{/if}}
    </div>
    {{/tag}}
    {{/is}}
    {{/match}}

    {{!-- Featured post --}}
    {{> "featured-row" locale=locale}}

    {{!-- Post Grid. Both the hero and the grid come from the page's own `posts` list:
         the hero is its first post and the grid starts after it, so the hero is never
         displayed twice. --}}
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {{> "listing-grid" locale=locale}}
    </section>

    {{!-- Pagination --}}
    {{pagination}}
</div>