{{!-- Feature image for posts and pages.
     `class` is optional: callers that need different sizing pass one, and the theme's
     default is used otherwise — the argument used to be accepted and silently ignored.
     The wrapper <figure> carries no class of its own: the <img> is the only styled
     element, and Tailwind's preflight already resets figure margins. --}}
{{#if feature_image}}
<figure>
    <img src="{{img_url feature_image size="xl" format="webp"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        class="{{#if class}}{{class}}{{else}}w-full h-auto object-cover rounded-xl border border-border-subtle shadow-2xl{{/if}}">
</figure>
{{/if}}
