{{!-- Post-only vendor CSS. Kept before the theme stylesheet so the theme's
     tocbot/prism overrides keep winning, exactly as they did under gulp. --}}
{{#is "post"}}
<link rel="stylesheet" type="text/css" href="{{asset "vendor/prism-window.css"}}" />
<link rel="stylesheet" type="text/css" href="{{asset "vendor/tocbot.css"}}" />
{{/is}}
{{!-- Compiled Tailwind CSS + modulepreload, generated by the Vite build --}}
{{> "vite_assets/head"}}
{{> "island-config"}}
