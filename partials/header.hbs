<header class="sticky top-0 z-50 w-full bg-[#0d0e11]/80 backdrop-blur-md border-b border-white/10 py-3 min-h-[60px]">
  {{!-- Inner container to keep spacing consistent with the rest of the theme --}}
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">

    <div class="flex items-center">
        {{#if @site.logo}}
        <a href="{{@site.url}}" rel="me" alt="{{@site.title}}" aria-label="{{@site.title}}">
          <img src="{{@site.logo}}" alt="{{@site.title}}" class="h-7 w-auto sm:h-8" />
        </a>
        {{else}}
        <a href="{{@site.url}}"
          class="text-2xl font-bold tracking-tight text-white transition-colors hover:text-brand-purple">{{@site.title}}<span class="text-brand-orange">.</span></a>
        {{/if}}
        {{#if @site.icon}}
        <span class="mx-3 hidden h-6 w-px bg-white/15 sm:inline-block" aria-hidden="true"></span>
        <a href="{{@site.url}}" rel="me" aria-hidden="true" tabindex="-1"
          class="hidden rounded-md sm:inline-flex">
          <img src="{{@site.icon}}" alt="" class="h-7 w-7 rounded-md" />
        </a>
        {{/if}}
    </div>

    {{!-- Desktop Navigation (Horizontal) --}}
    <div class="hidden md:flex items-center">
      {{#if @site.navigation}}
      {{navigation type="primary"}}
      {{/if}}
      {{!-- <a href="/subscribe/"
        class="bg-brand-purple hover:bg-blue-500 text-white font-semibold py-2 px-5 rounded-lg text-sm transition-colors">Subscribe</a> --}}
    </div>

    {{!-- Search & Account (opt-in via theme settings) --}}
    <div class="icon-pill hidden md:inline-flex">
      {{#if @custom.show_search}}
      <button type="button" data-ghost-search
        aria-label="{{t "Search"}}" title="{{t "Search"}}">
        <i class="fas fa-magnifying-glass text-xs"></i>
      </button>
      {{/if}}
      {{#if @custom.show_login}}
      <a href="#/portal/signin" data-portal="signin"
        aria-label="{{t "Sign in"}}" title="{{t "Sign in"}}">
        <i class="fas fa-user text-xs"></i>
      </a>
      {{/if}}
    </div>

    {{!-- Mobile Menu Toggle --}}
    <button id="mobile-toggle" type="button" class="rounded-lg p-2 text-gray-400 transition-colors hover:text-white md:hidden" aria-label="Toggle navigation menu" aria-controls="mobile-menu" aria-expanded="false"><i class="fas fa-bars text-xl"></i></button>

    {{!-- Mobile Menu Overlay (Vertical items) --}}
    <nav id="mobile-menu"
      class="hidden absolute top-full left-0 right-0 bg-[#0d0e11]/95 backdrop-blur-md border-b border-white/10 p-6 flex-col gap-4 text-sm font-medium z-50">
      {{#if @site.navigation}}
      {{navigation type="primary"}}
      {{/if}}
      {{!-- <a href="/subscribe/"
        class="bg-brand-purple hover:bg-blue-500 text-white font-semibold py-2 px-5 rounded-lg text-center transition-colors mt-2">Subscribe</a> --}}
      {{#if @custom.show_search}}
      <button type="button" data-ghost-search
        class="flex items-center gap-2 text-gray-400 transition-colors hover:text-white">
        <i class="fas fa-magnifying-glass"></i> {{t "Search"}}
      </button>
      {{/if}}
      {{#if @custom.show_login}}
      <a href="#/portal/signin" data-portal="signin"
        class="flex items-center gap-2 text-gray-400 transition-colors hover:text-white">
        <i class="fas fa-user"></i> {{t "Sign in"}}
      </a>
      {{/if}}
    </nav>

  </div>
</header>
