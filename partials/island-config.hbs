{{!-- Configuration for client islands, read by assets/js/lib/theme-config.js.
     Serialised with {{json}} — the documented safe way to put values into a
     script body; never interpolate with {{{ }}} here.

     Keys are flat and named exactly as the islands read them. Keep it small:
     this is inline on every page, and anything already rendered in the DOM
     should be read from the DOM instead. Add a key only when an island uses it.

     Why the strings are written out per locale instead of being read from
     locales/*.json through the translate helper: it renders the *site*
     language, which Ghost sets once in Admin, and it takes no locale argument —
     so on a site configured as English it returns English on a Spanish post no
     matter what the document says. The page's own language only reaches here as
     the `locale` key handed down by default-es.hbs / default-br.hbs, and matching
     on it is the same remedy the rest of the theme uses for per-locale markup.
     The strings are copied verbatim from locales/es.json and locales/pt.json, so
     those files stay the place a translator edits and this stays a lookup.

     The final branch keeps the helper: an unlisted locale still falls back to
     English through it, and a site whose language is es/pt keeps working even
     where no locale shell is in play. --}}
<script id="theme-config" type="application/json">
{{#match locale "=" "es"}}
{{json
    siteUrl=@site.url
    locale="es"
    toc="Índice de contenidos"
    copyLink="Copiar enlace"
    linkCopied="¡Enlace copiado!"
    share="Compartir"
    shareVia="Compartir por correo"
    openMenu="Abrir menú"
    closeMenu="Cerrar menú"
    readingProgress="Progreso de lectura"
    secFeedLoading="Cargando los últimos avisos…"
    secFeedEmpty="No hay avisos por ahora."
    secFeedError="No se pudo cargar el feed de seguridad."
    secFeedRetry="Reintentar"
    secFeedUpdated="Actualizado"
    secFeedFilterAll="Todos"
    secFeedFilterLabel="Filtrar por tema"
    secFeedViewAll="Ver el feed de seguridad completo"
    secFeedStale="Mostrando la última actualización: el feed no responde."
    secFeedSample="Datos de ejemplo: no se puede alcanzar ninguna fuente en vivo."
    secFeedSources="Algunas fuentes no están disponibles ahora."
    secFeedList="Últimos avisos de seguridad"
    secFeedAdvisoryOne="1 aviso"
    secFeedAdvisoryMany="% avisos"
}}
{{else match locale "=" "br"}}
{{json
    siteUrl=@site.url
    locale="br"
    toc="Sumário"
    copyLink="Copiar link"
    linkCopied="Link copiado!"
    share="Compartilhar"
    shareVia="Compartilhar por e-mail"
    openMenu="Abrir menu"
    closeMenu="Fechar menu"
    readingProgress="Progresso de leitura"
    secFeedLoading="Carregando os últimos avisos…"
    secFeedEmpty="Nenhum aviso no momento."
    secFeedError="Não foi possível carregar o feed de segurança."
    secFeedRetry="Tentar novamente"
    secFeedUpdated="Atualizado"
    secFeedFilterAll="Todos"
    secFeedFilterLabel="Filtrar por tema"
    secFeedViewAll="Ver o feed de segurança completo"
    secFeedStale="Exibindo a última atualização: o feed não está respondendo."
    secFeedSample="Dados de exemplo: nenhuma fonte ao vivo está acessível."
    secFeedSources="Algumas fontes estão indisponíveis agora."
    secFeedList="Últimos avisos de segurança"
    secFeedAdvisoryOne="1 aviso"
    secFeedAdvisoryMany="% avisos"
}}
{{else}}
{{json
    siteUrl=@site.url
    locale=@site.locale
    toc=(t "Table of Contents")
    copyLink=(t "Copy link")
    linkCopied=(t "Link copied!")
    share=(t "Share")
    shareVia=(t "Share via Email")
    openMenu=(t "Open menu")
    closeMenu=(t "Close menu")
    readingProgress=(t "Reading progress")
    secFeedLoading=(t "Loading the latest advisories…")
    secFeedEmpty=(t "No advisories right now.")
    secFeedError=(t "The security feed could not be loaded.")
    secFeedRetry=(t "Try again")
    secFeedUpdated=(t "Updated")
    secFeedFilterAll=(t "All")
    secFeedFilterLabel=(t "Filter by topic")
    secFeedViewAll=(t "View the full live feed")
    secFeedStale=(t "Showing the last update — the feed is not responding.")
    secFeedSample=(t "Sample data — no live source is reachable.")
    secFeedSources=(t "Some sources are unreachable right now.")
    secFeedList=(t "Latest security advisories")
    secFeedAdvisoryOne=(t "1 advisory")
    secFeedAdvisoryMany=(t "% advisories")
}}
{{/match}}
</script>
