{{#is "post"}}
{{!-- Table of contents. It is derived from the rendered headings, which Handlebars
     cannot enumerate, so the island owns the whole card (heading included). Without
     JavaScript the card is simply absent — previously it was an empty labelled card
     plus a tocbot CDN request and an inline setTimeout race.
     data-island-lazy: on mobile the sidebar sits far below the article, so the chunk
     is only fetched when it comes near the viewport. --}}
<div data-island="TableOfContents" data-island-lazy data-target=".gh-content" data-headings="h2, h3"></div>
{{/is}}

<div>
    <h4 class="text-white text-lg font-bold mb-1">
      {{t "Share this post:"}}
    </h4>
  <div class="flex gap-2">
    {{> "social-share"}}
  </div>
</div>

<div class="border border-gray-700/70 rounded-lg p-6 bg-dark-card text-center shadow-lg">
  <h4 class="text-white text-lg font-bold mb-1">{{t "Stay in the loop"}}</h4>
  <p class="text-gray-400 text-xs mb-4">{{t "Get the latest posts delivered right to your inbox"}}</p>
  <div class="space-y-3">
    <div class="flex flex-col gap-2">
      <form data-members-form="subscribe">
        <input type="email" required data-members-email class="w-full bg-dark-bg border border-gray-700 rounded-md py-2 px-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple focus:ring-1 focus:ring-brand-purple transition-all">
        <button type="submit" class="w-full bg-brand-purple hover:bg-blue-500 text-white font-semibold py-2 rounded-md text-sm transition-colors">
        {{t "Register with Email"}}
        </button>
        {{!-- Ghost's members script adds .success/.error to the form; theme.css keeps these hidden until then. --}}
        <p class="message-success text-xs text-green-400 mt-2" role="status">{{t "Almost finished! Please check your inbox to confirm your subscription."}}</p>
        <p class="message-error text-xs text-red-400 mt-2" role="alert">{{t "Sorry, something went wrong. Please try again."}}</p>
      </form>
    </div>
    {{!-- <a href="#" class="text-gray-500 text-[10px] hover:text-gray-300 transition-colors block mt-1">Skip for now</a> --}}
  </div>
</div>