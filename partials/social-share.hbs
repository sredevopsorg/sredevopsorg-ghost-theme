{{!-- Share links.
     Server-rendered plain navigations on purpose: they work with JavaScript
     disabled and cost nothing to keep. The ShareButtons island adds only what the
     links cannot do — the native share sheet and copy-to-clipboard with feedback —
     and replaces the inline onclick + alert() that used to live here (an inline
     handler cannot be covered by Ghost's CSP nonce).

     Icon-only links carry a brand name as their accessible name; brand names are
     not translated. --}}

<a href="mailto:?subject={{encode title}}&body={{url absolute="true"}}" target="_blank" rel="noopener noreferrer"
  class="social-icon-box" aria-label="{{t "Share via Email"}}" title="{{t "Share via Email"}}">
  <i class="fa-regular fa-envelope text-sm" aria-hidden="true"></i>
</a>

<a href="https://x.com/intent/tweet?url={{url absolute="true"}}&text={{encode title}}" target="_blank"
  rel="noopener noreferrer" class="social-icon-box" aria-label="X" title="X">
  <i class="fa-brands fa-x text-sm" aria-hidden="true"></i>
</a>

<a href="https://facebook.com/sharer/sharer.php?u={{url absolute="true"}}" target="_blank" rel="noopener noreferrer"
  class="social-icon-box" aria-label="Facebook" title="Facebook">
  <i class="fa-brands fa-facebook text-sm" aria-hidden="true"></i>
</a>

<a href="https://linkedin.com/shareArticle?mini=true&url={{url absolute="true"}}&title={{encode title}}"
  target="_blank" rel="noopener noreferrer" class="social-icon-box" aria-label="LinkedIn" title="LinkedIn">
  <i class="fa-brands fa-linkedin-in text-sm" aria-hidden="true"></i>
</a>

<a href="https://api.whatsapp.com/send?text={{encode title}}%20{{url absolute="true"}}" target="_blank"
  rel="noopener noreferrer" class="social-icon-box" aria-label="WhatsApp" title="WhatsApp">
  <i class="fa-brands fa-whatsapp text-sm" aria-hidden="true"></i>
</a>

<a href="https://reddit.com/submit?url={{url absolute="true"}}&title={{encode title}}" target="_blank"
  rel="noopener noreferrer" class="social-icon-box" aria-label="Reddit" title="Reddit">
  <i class="fa-brands fa-reddit text-sm" aria-hidden="true"></i>
</a>

<a href="https://mastodon.social/share?text={{encode title}}%20{{url absolute="true"}}" target="_blank"
  rel="noopener noreferrer" class="social-icon-box" aria-label="Mastodon" title="Mastodon">
  <i class="fa-brands fa-mastodon text-sm" aria-hidden="true"></i>
</a>

{{!-- The island renders buttons only, no wrapper box, so `contents` keeps them as
     flex items of the container in partials/sidebar.hbs rather than adding a gap
     for an empty element. data-island-lazy: on mobile this sits below the article. --}}
<div data-island="ShareButtons" data-island-lazy class="contents"></div>
